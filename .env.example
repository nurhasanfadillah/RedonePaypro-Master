# RedonePaypro — Environment Variables
# Salin file ini menjadi .env dan isi nilainya sebelum menjalankan app.
# Jangan commit file .env ke repository.

# ─────────────────────────────────────────────
# NEONDB (Required)
# Dapatkan dari: https://console.neon.tech → Project → Connection Details
# ─────────────────────────────────────────────

# Pooled connection — digunakan app saat runtime (Vercel Functions)
DATABASE_URL=postgresql://neondb_owner:***@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection — digunakan drizzle-kit push/pull (schema migrations)
# Sama seperti DATABASE_URL tapi tanpa "-pooler" di hostname
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:***@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────
# GOOGLE GEMINI (Optional — belum aktif digunakan)
# Dapatkan dari: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────

# API key Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
