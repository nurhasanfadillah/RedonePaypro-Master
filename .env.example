# RedonePaypro — Environment Variables
# Salin file ini menjadi .env dan isi nilainya sebelum menjalankan app.
# Jangan commit file .env ke repository.

# ─────────────────────────────────────────────
# SUPABASE (Required)
# Dapatkan dari: https://supabase.com → Project Settings → API
# ─────────────────────────────────────────────

# URL project Supabase Anda
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key Supabase (aman untuk di-expose di frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
# GOOGLE GEMINI (Optional — belum aktif digunakan)
# Dapatkan dari: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────

# API key Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
